# =============================================================================
#  GERADOR DE ATA E MOMENTO ABERTO — variáveis de ambiente do SERVIDOR (backend)
# =============================================================================
#  • Uso local: copie este arquivo para ".env" e preencha.
#  • Vercel / Cloudflare: cadastre as MESMAS variáveis no painel do serviço.
#  • O arquivo ".env" está no .gitignore: NUNCA envie sua chave ao GitHub.
# =============================================================================

# Chave da API do Google Gemini (obrigatória). Crie em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Senha exigida pela interface para usar este servidor (muito recomendada).
# Sem ela, qualquer pessoa que descubra o endereço do servidor pode gastar a sua cota de IA.
ACCESS_PASSWORD=

# Endereços (origens) autorizados a chamar este servidor, separados por vírgula.
# Para o GitHub Pages use somente a origem, sem o nome do repositório:
#   ALLOWED_ORIGINS=https://seu-usuario.github.io
# Em branco = qualquer origem (aceitável apenas para testes locais).
ALLOWED_ORIGINS=

# ----------------------------------------------------------------------------
#  Opcionais (os padrões atendem à maioria dos casos)
# ----------------------------------------------------------------------------

# Modelo do Gemini. "gemini-flash-latest" aponta sempre para o Flash mais recente.
# GEMINI_MODEL=gemini-flash-latest
# Modelos distintos para transcrever e para redigir (se quiser separar custo e qualidade):
# GEMINI_TRANSCRIPTION_MODEL=gemini-flash-latest
# GEMINI_TEXT_MODEL=gemini-flash-latest
# Modelos tentados, em ordem, se o principal não existir mais ou não estiver na sua cota:
# GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-2.5-flash

# Nível de raciocínio dos modelos Gemini 3 (low | medium | high). Em branco = padrão do modelo.
# GEMINI_THINKING_LEVEL=
# Temperatura (0 a 2). Em branco = padrão do modelo (recomendado nos modelos Gemini 3).
# GEMINI_TEMPERATURE=

# Tamanho máximo de cada trecho de áudio, em MB. Padrão 4 (limite de 4,5 MB por requisição
# da Vercel). Em Cloudflare Workers ou servidor próprio pode subir até 14.
# MAX_AUDIO_MB=4

# Tempo máximo, em segundos, que o servidor espera a IA em cada requisição (padrão 280).
# REQUEST_BUDGET_SECONDS=280

# Porta do servidor local (npm start). Padrão 3000.
# PORT=3000

# Provedor de IA: "gemini" (padrão), "local" (Whisper + Ollama no seu computador,
# sem serviço externo — veja instalacao-local/LEIA-ME.md) ou "mock" (teste, sem IA).
# AI_PROVIDER=gemini

# ----------------------------------------------------------------------------
#  Modo LOCAL (AI_PROVIDER=local) — o instalador instalacao-local/instalar.cmd
#  baixa as ferramentas e preenche estas variáveis automaticamente.
# ----------------------------------------------------------------------------

# Caminho do executável do whisper.cpp (whisper-cli.exe) e do modelo ggml-*.bin.
# WHISPER_CLI=
# WHISPER_MODEL=
# Idioma da transcrição (padrão pt) e número de núcleos usados (padrão 4).
# WHISPER_LANGUAGE=pt
# WHISPER_THREADS=4

# Endereço do Ollama (padrão http://127.0.0.1:11434) e modelo de redação.
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.1:8b
# Janela de contexto do modelo local (padrão 16384; maior = mais memória RAM).
# OLLAMA_NUM_CTX=16384
